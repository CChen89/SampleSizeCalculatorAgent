# Clinical Trial Sample Size Calculator Agent - Environment Configuration
# Copy this file to .env and fill in your actual values

# Azure OpenAI Configuration
ILIAD_API_KEY=your_azure_openai_api_key_here
ILIAD_URL_BASE=your_azure_openai_endpoint_here
API_VERSION=2023-07-01-preview
DEPLOYMENT=gpt-4o

# Alternative OpenAI Configuration (if not using Azure)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google API Key (for additional models)
# GOOGLE_API_KEY=your_google_api_key_here

# R MCP Server Configuration (optional)
# R_MCP_SERVER_URL=http://127.0.0.1:9291
# R_MCP_SERVER_TIMEOUT=300

# Chainlit Configuration (optional)
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8000

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# LOG_FILE=sample_size_calculator.log

# Example Values (replace with your actual credentials):
# ILIAD_API_KEY=abcd1234efgh5678ijkl9012mnop3456
# ILIAD_URL_BASE=https://your-resource.openai.azure.com